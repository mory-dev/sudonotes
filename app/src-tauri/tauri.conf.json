{
  "$schema": "../gen/schemas/desktop-schema.json",
  "productName": "sudonotes",
  "version": "0.3.0",
  "identifier": "com.sudonotes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "sudonotes",
        "width": 1096,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2QzNFQjExMDJDMkJENkQKUldSdHZjSUNFZXZEbHU0bDg2aktvYkp6QjAreDRzNVg2KzAvYVdxTmowdTMyak5hUFJ5NnNoVmgK",
      "endpoints": [
        "https://github.com/mory-dev/sudonotes/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "signCommand": {
        "cmd": "cmd",
        "args": ["/C", "sign-windows.cmd", "%1"]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
