---
import { Font } from "astro:assets";
import Wordmark from "../components/Wordmark.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Set on article-ish pages so the JSON-LD describes the right thing. */
  type?: "website" | "article";
}

const { title, description, type = "website" } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL("/og.png", Astro.site).href;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { href: "/features", label: "Features" },
  { href: "/docs", label: "Docs", wide: false },
  { href: "/open-source", label: "Open source", wide: true },
  { href: "/roadmap", label: "Roadmap", wide: true },
  { href: "/download", label: "Download" },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "sudonotes",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Windows, macOS, Linux",
  description:
    "Organize the AI prompts you keep rewriting and the ideas behind them. Plain Markdown in a folder you own. Free, MIT licensed, no account.",
  url: "https://sudonotes.com",
  image: "https://sudonotes.com/og.png",
  sameAs: ["https://github.com/mory-dev/sudonotes"],
  license: "https://opensource.org/licenses/MIT",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- No `keywords` meta: search engines have ignored it for twenty years. -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#16171a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="sudonotes — a local-first notebook for AI prompts and ideas" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="sudonotes" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />

    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Self-hosted faces, emitted at build time by experimental.fonts. -->
    <Font cssVariable="--font-ui" preload={true} />
    <Font cssVariable="--font-mono" preload={true} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <nav class="site-nav">
      <div class="page">
        <a class="brand" href="/" aria-label="sudonotes home">
          <span class="brand-mark" aria-hidden="true"></span><span class="brand-word">sudonotes</span
          ><span class="brand-caret" aria-hidden="true"></span>
        </a>
        <div class="nav-links">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class={item.wide ? "nav-hide" : undefined}
                aria-current={path === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="page">
        <span class="footer-brand"><Wordmark /> — MIT licensed</span>
        <a href="/docs/privacy">Privacy</a>
        <a href="/changelog">Changelog</a>
        <a href="/roadmap">Roadmap</a>
        <span class="spacer"></span>
        <a class="github" href="https://github.com/mory-dev/sudonotes" aria-label="sudonotes on GitHub">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            />
          </svg>
        </a>
      </div>
    </footer>
  </body>
</html>
