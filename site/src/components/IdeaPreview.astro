---
/** An idea note broken into bubbles, each pointed at its own model. Mock data. */
const { caption } = Astro.props;
---

<figure class="shot-figure">
  <div class="shot">
    <div class="shot-chrome">
      <div class="shot-dots">
        <span class="shot-dot"></span><span class="shot-dot"></span><span class="shot-dot"></span>
      </div>
      <span class="shot-title">Offline-first sync design</span>
    </div>

    <div class="shot-body one-col">
      <main class="shot-main" data-type="idea">
        <div class="shot-titlebar">
          <span class="shot-mark filled round"></span>
          <h4>Offline-first sync design</h4>
          <span class="shot-badge">Idea</span>
        </div>

        <div class="shot-content">
          <div class="shot-bubble">
            <div class="shot-bubble-head">
              <span>Conflict model</span>
              <span class="shot-model"
                ><span class="shot-chip chip-an">A</span>claude-opus-5</span
              >
            </div>
            <p>
              Two writers, one folder. Fingerprint on open, re-stat before write, and offer
              reload / keep mine / save a copy. Never a silent overwrite.
            </p>
            <div class="shot-heat" style="--heat:78%"></div>
          </div>

          <div class="shot-bubble">
            <div class="shot-bubble-head">
              <span>What the index is for</span>
              <span class="shot-model"
                ><span class="shot-chip chip-ds">D</span>deepseek-chat</span
              >
            </div>
            <p>
              The database is a cache. Markdown is the truth. If they disagree, the files win and
              the index gets rebuilt.
            </p>
            <div class="shot-heat" style="--heat:52%"></div>
          </div>

          <div class="shot-bubble">
            <div class="shot-bubble-head">
              <span>Open question: ordering</span>
              <span class="shot-model"><span class="shot-chip chip-gm">G</span>gemini-3-pro</span>
            </div>
            <p>
              Ranking will differ between the two search backends. Say so in the docs rather than
              pretending they match.
            </p>
            <div class="shot-heat" style="--heat:24%"></div>
          </div>
        </div>
      </main>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
