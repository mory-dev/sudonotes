---
/**
 * The full window: sidebar, an open collection, and the details panel.
 * Mock data throughout — no real vault is depicted.
 */
const { caption } = Astro.props;
---

<figure class="shot-figure">
  <div class="shot">
    <div class="shot-chrome">
      <div class="shot-dots">
        <span class="shot-dot"></span><span class="shot-dot"></span><span class="shot-dot"></span>
      </div>
      <span class="shot-title">sudonotes — ~/vault</span>
    </div>

    <div class="shot-body">
      <aside class="shot-side">
        <div class="shot-search"><span>Search</span><kbd>Ctrl K</kbd></div>

        <div data-type="prompt">
          <div class="shot-section-head">
            <span class="shot-mark filled"></span>Prompts <span class="shot-count">9</span>
            <span class="shot-plus">+</span>
          </div>
          <ul class="shot-list">
            <li class="shot-group active">
              <span>Release notes pipeline</span>
              <span class="shot-stack">
                <span class="shot-chip chip-ds">D</span>
                <span class="shot-chip chip-an">A</span>
                <span class="shot-chip chip-oa">O</span>
              </span>
              <span class="shot-count">4</span>
            </li>
            <li class="shot-row nested">Collect merged PRs</li>
            <li class="shot-row nested">Group by surface</li>
            <li class="shot-row nested">Draft the changelog</li>
            <li class="shot-row nested">Tighten to one screen</li>
            <li class="shot-group">
              <span>Onboarding emails</span>
              <span class="shot-stack">
                <span class="shot-chip chip-gm">G</span>
                <span class="shot-chip chip-ds">D</span>
              </span>
              <span class="shot-count">3</span>
            </li>
            <li class="shot-row">Bug triage classifier</li>
            <li class="shot-row">Schema migration reviewer</li>
          </ul>
        </div>

        <div data-type="idea">
          <div class="shot-section-head">
            <span class="shot-mark filled round"></span>Ideas <span class="shot-count">4</span>
            <span class="shot-plus">+</span>
          </div>
          <ul class="shot-list">
            <li class="shot-row">Offline-first sync design</li>
            <li class="shot-row">Pricing experiments</li>
            <li class="shot-row">Landing page angles</li>
            <li class="shot-row">Eval harness sketch</li>
          </ul>
        </div>

        <div class="shot-vault">
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 1.5 13.5 3.5v4c0 3.4-2.3 5.9-5.5 7-3.2-1.1-5.5-3.6-5.5-7v-4Z"></path>
            <path d="M5.5 8l1.7 1.7 3.3-3.4"></path>
          </svg>
          <span>~/vault</span>
        </div>
      </aside>

      <main class="shot-main" data-type="prompt">
        <div class="shot-titlebar">
          <span class="shot-mark filled"></span>
          <h4>Release notes pipeline</h4>
          <span class="shot-badge">Prompt</span>
        </div>

        <div class="shot-content">
          <article class="shot-card">
            <div class="shot-card-head">
              <span class="shot-card-index">1</span>
              <span class="shot-card-title">Collect merged PRs</span>
              <span class="shot-model"><span class="shot-chip chip-ds">D</span>deepseek-chat</span>
            </div>
            <p class="shot-card-body">List every PR merged since {"{{last_tag}}"}. For each: the
title, the area it touched, and whether a user would notice. Skip
dependency bumps and CI-only changes.</p>
            <div class="shot-tags">
              <span class="shot-tag">docs</span><span class="shot-tag">workflow</span>
            </div>
          </article>

          <article class="shot-card">
            <div class="shot-card-head">
              <span class="shot-card-index">2</span>
              <span class="shot-card-title">Group by surface</span>
              <span class="shot-model"><span class="shot-chip chip-an">A</span>claude-opus-5</span>
            </div>
            <p class="shot-card-body">Cluster the entries into Editor, Search, Sync and Fixes.
Order each group by how much a user would care, not by merge date.</p>
            <div class="shot-tags"><span class="shot-tag">product</span></div>
          </article>

          <article class="shot-card">
            <div class="shot-card-head">
              <span class="shot-card-index">3</span>
              <span class="shot-card-title">Draft the changelog</span>
              <span class="shot-model"><span class="shot-chip chip-oa">O</span>gpt-5.2</span>
            </div>
            <p class="shot-card-body">Write it in the voice of [[Changelog style guide]]. One line
per entry, present tense, no adjectives.</p>
            <div class="shot-tags">
              <span class="shot-tag">docs</span><span class="shot-tag">marketing</span>
            </div>
          </article>
        </div>
      </main>

      <aside class="shot-panel" data-type="prompt">
        <div>
          <div class="shot-panel-head">Linked from <span class="shot-count">2</span></div>
          <ul class="shot-list">
            <li class="shot-row" data-type="idea">
              <span class="shot-mark round"></span>Eval harness sketch
            </li>
            <li class="shot-row" data-type="prompt">
              <span class="shot-mark"></span>Changelog style guide
            </li>
          </ul>
        </div>

        <div>
          <div class="shot-panel-head">Details</div>
          <dl class="shot-meta">
            <div class="shot-meta-row"><dt>Type</dt><dd><span class="shot-badge">Prompt</span></dd></div>
            <div class="shot-meta-row"><dt>Tags</dt><dd>docs · workflow</dd></div>
            <div class="shot-meta-row"><dt>Model</dt><dd>deepseek-chat</dd></div>
            <div class="shot-meta-row"><dt>Updated</dt><dd>Aug 6, 2026</dd></div>
            <div class="shot-meta-row">
              <dt>File</dt><dd>prompts/release-notes-pipeline.md</dd>
            </div>
          </dl>
        </div>

        <div>
          <div class="shot-panel-head">AI assistance</div>
          <div class="shot-toggle">
            <span class="shot-check">✓</span><span>Refinements &amp; tagging</span>
          </div>
          <p class="shot-sub" style="margin-top:6px">On for this vault. Off by a click.</p>
        </div>
      </aside>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
