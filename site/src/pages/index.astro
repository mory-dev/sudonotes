---
import AppPreview from "../components/AppPreview.astro";
import IdeaBubbles from "../components/IdeaBubbles.astro";
import PromptChain from "../components/PromptChain.astro";
import ModelPreview from "../components/ModelPreview.astro";
import SearchPreview from "../components/SearchPreview.astro";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Wordmark from "../components/Wordmark.astro";
import { APPLE, GITHUB, LAUNCH, LINUX, PACKAGE, SCALE, WINDOWS } from "../lib/icons";
import { CLOUD, LEAF, LEAF_VEIN } from "../lib/marks";
import "../styles/preview.css";

// The web app is its own deployment on its own subdomain, so the hero links out
// by absolute URL rather than by route. In development that deployment is the
// app's Vite server; PUBLIC_APP_URL overrides either.
const APP_URL =
  import.meta.env.PUBLIC_APP_URL ??
  (import.meta.env.DEV ? "http://localhost:1420" : "https://app.sudonotes.com");
---

<Base
  title="sudonotes — a local-first notebook for AI prompts and ideas"
  description="Organize the AI prompts you keep rewriting and the ideas behind them. Plain Markdown in a folder you own. Free, MIT licensed, no account."
  schema="software"
>
  <section class="hero page">
    <h1>
      Organize your <span class="hl prompt"><svg viewBox="0 0 16 16" aria-hidden="true"
          ><path d={CLOUD}></path></svg
        >prompts</span> and <span class="hl idea"
        ><svg viewBox="0 0 16 16" aria-hidden="true"
          ><path d={LEAF}></path><path d={LEAF_VEIN}></path></svg
        >ideas</span>.
    </h1>
    <p class="lede">
      Keep prompt drafts, model assignments, and idea notes in one local folder of plain Markdown.
      No account. No cloud lock-in. Just the notes you own, on the machine you choose.
    </p>

    <div class="actions">
      <a class="button primary" href={APP_URL}>
        <Icon path={LAUNCH} size={16} stroke />Start now
      </a>
      <a class="button" href="https://github.com/mory-dev/sudonotes">
        <Icon path={GITHUB} size={16} />View the source
      </a>
    </div>

    <ul class="hero-meta muted">
      <li><Icon path={SCALE} size={15} stroke />Free and MIT licensed</li>
      <li>
        <span class="platforms">
          <Icon path={WINDOWS} size={14} label="Windows" />
          <Icon path={APPLE} size={14} label="macOS" />
          <Icon path={LINUX} size={14} label="Linux" />
        </span>
        Windows, macOS and Linux
      </li>
      <li><Icon path={PACKAGE} size={14} stroke />~20&nbsp;MB installer</li>
    </ul>

    <div class="hero-shot">
      <AppPreview caption="A bucket of reusable prompts, each aimed at the model that suits it." />
    </div>
  </section>

  <section class="band alt">
    <div class="page stack" style="gap:16px">
      <h2>
        You have written this <span class="hl prompt"
          ><svg viewBox="0 0 16 16" aria-hidden="true"><path d={CLOUD}></path></svg
          >prompt</span
        > before.
      </h2>
      <p class="lede">
        Prompts scatter across chat histories, scratch files and half-abandoned docs. So the next
        time you need one you write it from scratch — slightly worse than last time, and you spend
        the tokens finding that out.
      </p>
      <p class="lede">
        <Wordmark /> gives that work somewhere to live. A prompt you refine once stays refined, the
        idea that produced it stays attached, and nothing is retyped because you could not find it.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="page split">
      <div class="stack" style="gap:16px">
        <p class="eyebrow">Brainstorm ideas</p>
        <h2>
          Think in <span class="hl-clause"><span class="hl bubble">bubbles</span>,</span> not walls
          of text.
        </h2>
        <p class="lede">
          An idea note splits into bubbles — one per block you write. Hover any bubble to point it
          at its own model, or to copy just that piece: the thinking step and the drafting step
          rarely want the same model.
        </p>
        <p class="lede">
          The idea that produced a prompt stays attached to it, so a month from now you still know
          what you meant.
        </p>
      </div>
      <IdeaBubbles caption="One idea, split into bubbles, each pointed at its own model." />
    </div>
  </section>

  <section class="band alt">
    <div class="page split reverse">
      <ModelPreview caption="The model picker, reading the live catalog." />
      <div class="stack" style="gap:16px">
        <p class="eyebrow">Match prompt and model</p>
        <h2>
          Every <span class="hl prompt"
            ><svg viewBox="0 0 16 16" aria-hidden="true"><path d={CLOUD}></path></svg
            >prompt</span
          > knows what it is for.
        </h2>
        <p class="lede">
          Point a prompt — or a single bubble inside an idea — at a specific model, picked from a
          live catalog that carries each model's context window, reasoning and vision support. Not
          a hardcoded list that goes stale a month after you install it.
        </p>
        <p class="lede">
          A bucket shows the stack of models its prompts point at, so an orchestration is legible
          from the sidebar instead of buried in the text.
        </p>
      </div>
    </div>
  </section>

  <section class="band full">
    <div class="page stack" style="gap:16px">
      <h2>
        Turn a messy <span class="hl prompt"
          ><svg viewBox="0 0 16 16" aria-hidden="true"><path d={CLOUD}></path></svg
          >prompt</span
        > chain into editable steps.
      </h2>
      <p class="lede">
        Paste a multi-step prompt and <Wordmark /> breaks it into ordered prompts inside one
        collection. Reorder the steps by drag-and-drop, and keep each step's model, tags, and file separate.
      </p>
      <p class="lede">
        The result is a workflow you can change step by step instead of a single long prompt blob.
      </p>

      <div class="chain-shot">
        <PromptChain caption="One paste, four ordered steps — each with its own model and file." />
      </div>
    </div>
  </section>

  <section class="band alt">
    <div class="page split">
      <div class="stack" style="gap:16px">
        <p class="eyebrow">Iterate effectively and quickly</p>
        <h2>Everything is one keystroke away.</h2>
        <p class="lede">
          Full-text search across every note, ranked so titles win over passing mentions.
          <kbd>Ctrl K</kbd> from anywhere. Backlinks show you what depends on the note you are about
          to change — before you change it.
        </p>
      </div>
      <SearchPreview caption="Ctrl K, then type. Titles rank above passing mentions." />
    </div>
  </section>

  <section class="band">
    <div class="page stack" style="gap:16px">
      <h2>
        <span class="hl idea"
          ><svg viewBox="0 0 16 16" aria-hidden="true"
            ><path d={LEAF}></path><path d={LEAF_VEIN}></path></svg
          >Ideas</span
        > that live next to the code.
      </h2>
      <p class="lede">
        Link an idea to a project folder and <Wordmark /> mirrors it to an <code>IDEAS.md</code> in
        that repository. The thinking travels with the work, where the next person — or the next
        agent — will actually look for it.
      </p>
      <p class="lede">
        In a Git repository, the mirror is added to <code>.gitignore</code> so local coding agents
        can use it without publishing your notes.
      </p>
      <p><a href="/docs/project-linking">Learn how to link project ideas through IDEAS.md →</a></p>
    </div>
  </section>

  <section class="band alt">
    <div class="page stack" style="gap:26px">
      <div class="stack" style="gap:14px">
        <p class="eyebrow">Build something impactful</p>
        <h2>It is just Markdown, in a folder you chose.</h2>
        <p class="lede">
          No database you cannot read, no export button you will need one day. A vault is
          <code>prompts/</code> and <code>ideas/</code> full of <code>.md</code> files with a few
          lines of YAML at the top. Edit them in any editor; <Wordmark /> notices and reloads.
        </p>
      </div>

      <div class="grid">
        <div class="card">
          <h3>Yours on disk</h3>
          <p>
            Put the vault in Dropbox, in a git repo, on an encrypted volume. <Wordmark /> has no
            opinion and no server holding it.
          </p>
        </div>
        <div class="card">
          <h3>Optional AI, on your terms</h3>
          <p>
            Tagging and review run through the <Wordmark /> service with no API key of your own.
            One switch per vault turns it off entirely.
          </p>
        </div>
        <div class="card">
          <h3>Small and fast</h3>
          <p>
            Built with Tauri on your system's webview — a ~20&nbsp;MB installer instead of a
            bundled browser.
          </p>
        </div>
        <div class="card">
          <h3>Open source</h3>
          <p>
            MIT. Read exactly what leaves your machine, or build it yourself and change what you
            disagree with.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="page stack" style="gap:20px; align-items:center; text-align:center">
      {/* The closing line pairs the two halves of the product, so it carries
          both marks rather than picking a side. */}
      <h2>
        Keep the <span class="hl prompt"
          ><svg viewBox="0 0 16 16" aria-hidden="true"><path d={CLOUD}></path></svg
          >prompts</span
        >. Keep the <span class="hl idea"
          ><svg viewBox="0 0 16 16" aria-hidden="true"
            ><path d={LEAF}></path><path d={LEAF_VEIN}></path></svg
          >thinking</span
        >.
      </h2>
      <p class="lede" style="max-width:52ch">
        <Wordmark /> is early and moving quickly. It is free, it is MIT, and your notes are files
        you can walk away with at any time.
      </p>
      <div class="actions" style="justify-content:center">
        <a class="button primary" href={APP_URL}>
          <Icon path={LAUNCH} size={16} stroke />Start now
        </a>
        {/* The hero no longer points at /download, so this is the home page's
            one remaining route to the installers. */}
        <a class="button" href="/download">Download for desktop</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(48px, 8vw, 88px) 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hero h1 {
    /* Wider than the plain headline needed: the two marks add ~2ch each, and at
       16ch that pushed "prompts" onto a line of its own. */
    max-width: 22ch;
  }

  /* The subject nouns carry the app's own colour coding: prompts read blue with
     the cloud, ideas read green with the leaf. Sized in `em` so the marks track
     whatever heading they land in rather than drifting at either end of a fluid
     clamp. Set on `.hl` rather than under `.hero h1`, because every section
     heading down the page marks its own subject the same way. */
  .hl {
    display: inline-flex;
    align-items: baseline;
    gap: 0.16em;
    white-space: nowrap;
  }

  .hl.prompt {
    color: var(--prompt);
  }

  .hl.idea {
    color: var(--idea);
  }

  .hl svg {
    /* `align-self` rather than a baseline sit: the glyph is optically centred on
       the lowercase body, which baseline alignment would drop too low. */
    align-self: center;
    flex: none;
    width: 0.78em;
    height: 0.78em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* "bubbles", drawn as one. The heading says what an idea note looks like, so
     the word wears the same tinted, rounded box the editor puts around a block.
     Padding is in `em` and the line-height is pinned, so the box hugs the word
     without opening up the heading's leading. */
  .hl.bubble {
    color: var(--idea);
    padding: 0.04em 0.4em 0.1em;
    line-height: 1.1;
    border: 1px solid color-mix(in srgb, var(--idea) 34%, transparent);
    border-radius: 0.46em;
    background: var(--idea-soft);
  }

  /* Punctuation after a boxed word is not a word of its own: without this the
     line broke between "bubbles" and its comma, and the next line opened on a
     stray comma. The negative margin closes the optical gap the box's own
     padding leaves behind it. */
  .hl-clause {
    white-space: nowrap;
  }

  .hl-clause > .bubble {
    margin-right: -0.12em;
  }

  .hero .actions {
    margin-top: 6px;
  }

  .hero-meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    font-size: 13.5px;
  }

  /* The icons group the facts on their own, so this drops the "·" separators
     the line used to need. */
  .hero-meta li {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .platforms {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .hero-shot {
    margin-top: clamp(30px, 5vw, 54px);
  }

  .split {
    display: grid;
    gap: clamp(28px, 5vw, 56px);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: center;
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .split.reverse > :first-child {
      order: 2;
    }
  }

  /* One wider, centered band to break the rhythm. */
  .band.full .page {
    width: min(100% - 40px, 1280px);
    align-items: center;
    text-align: center;
  }

  .band.full .lede {
    margin-inline: auto;
  }

  /* The band centres its prose; the diagram wants the full width under it. */
  .chain-shot {
    width: 100%;
    margin-top: clamp(22px, 3.5vw, 40px);
  }
</style>
