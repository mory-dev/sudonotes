---
import Base from "../../layouts/Base.astro";

const pages = [
  {
    href: "/docs/project-linking",
    title: "Project linking and IDEAS.md",
    blurb:
      "Keep an idea next to the code as a gitignored IDEAS.md that local coding agents can read.",
  },
  {
    href: "/docs/placeholders",
    title: "Prompt placeholders",
    blurb:
      "Write {{placeholders}} in a prompt and fill them in from the sidebar each time you use it.",
  },
  {
    href: "/docs/vault-format",
    title: "Vault format",
    blurb: "Exactly what sudonotes writes to disk, and how to read it without sudonotes.",
  },
  {
    href: "/docs/privacy",
    title: "Privacy",
    blurb: "What leaves your machine when AI is on, what does not, and how to turn it off.",
  },
  {
    href: "/docs/web-vs-desktop",
    title: "Web vs. desktop",
    blurb: "The planned browser app, what it will and will not be able to do, and why.",
  },
];
---

<Base
  title="Docs — sudonotes"
  description="Documentation for sudonotes: project linking through IDEAS.md, prompt placeholders, the vault format, privacy, and desktop behavior."
>
  <section class="page" style="padding-block: clamp(44px, 7vw, 76px)">
    <div class="prose">
      <p class="eyebrow">Docs</p>
      <h1>Documentation</h1>
      <p class="lede">
        Short and specific. If something here disagrees with the app, the app is right and this is a
        bug — please <a href="https://github.com/mory-dev/sudonotes/issues">say so</a>.
      </p>
    </div>

    <div class="grid" style="margin-top: 34px">
      {
        pages.map((page) => (
          <a class="card" href={page.href} style="text-decoration:none; display:block">
            <h3>{page.title}</h3>
            <p>{page.blurb}</p>
          </a>
        ))
      }
    </div>
  </section>
</Base>
