---
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { DOC_SECTIONS, docHref, docsInOrder } from "../../data/docs";
import { validateDocs } from "../../data/validateDocs";

const docs = docsInOrder(await getCollection("docs"));
validateDocs(docs);
---

<DocsLayout docs={docs} home>
  <button class="docs-home-search" type="button" data-docs-search-trigger>
    <span class="docs-search-icon" aria-hidden="true"></span>
    <span>Search guides, shortcuts, .bak recovery, IDEAS.md…</span>
    <kbd>Ctrl K</kbd>
  </button>

  <section aria-labelledby="quick-paths-title">
    <h2 id="quick-paths-title">Start with a task</h2>
    <div class="docs-quick-grid">
      <a href="/docs/getting-started">
        <span>01 / five minutes</span>
        <strong>Create your first vault</strong>
        <p>Open a folder, capture a prompt and an idea, then find them again.</p>
      </a>
      <a href="/docs/backups-and-recovery">
        <span>02 / recovery</span>
        <strong>Restore a `.bak` safely</strong>
        <p>Recover into a new empty folder without touching the vault you still have.</p>
      </a>
      <a href="/docs/ideas-md-for-llms">
        <span>03 / project context</span>
        <strong>Give an LLM the idea beside the code</strong>
        <p>Mirror an idea as local `IDEAS.md` and structure it for an implementation handoff.</p>
      </a>
    </div>
  </section>

  <section aria-labelledby="local-first-title">
    <h2 id="local-first-title">One idea, where it is useful</h2>
    <p>
      The vault owns the note. Backups protect the note outside the vault. A linked project gets a
      local mirror that a coding agent can read beside the source.
    </p>
    <div class="docs-local-map" aria-label="How sudonotes stores and shares a project idea">
      <div>
        <strong>Vault Markdown</strong>
        <span>Canonical, searchable `ideas/*.md`</span>
      </div>
      <b aria-hidden="true">→</b>
      <div>
        <strong>Project mirror</strong>
        <span>Gitignored `IDEAS.md` beside the code</span>
      </div>
      <b aria-hidden="true">→</b>
      <div>
        <strong>Local LLM</strong>
        <span>Reads the context only when given project access</span>
      </div>
    </div>
  </section>

  <div class="docs-grouped-index">
    {
      DOC_SECTIONS.map((section) => {
        const entries = docs.filter((entry) => entry.data.section === section.id);
        return (
          <section class="docs-index-section" aria-labelledby={`docs-section-${section.id}`}>
            <h2 id={`docs-section-${section.id}`}>{section.label}</h2>
            <p>{section.description}</p>
            <ul class="docs-index-links">
              {entries.map((entry) => (
                <li>
                  <a href={docHref(entry.id)}>
                    <strong>{entry.data.title}</strong>
                    <span>{entry.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>

  <div class="callout">
    <strong class="callout-title">Something disagrees with the app?</strong>
    The app is right and the docs have a bug. Start with <a href="/docs/troubleshooting">troubleshooting</a>
    or <a href="https://github.com/mory-dev/sudonotes/issues">report the mismatch</a>.
  </div>
</DocsLayout>
