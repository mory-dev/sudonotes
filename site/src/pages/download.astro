---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Wordmark from "../components/Wordmark.astro";
import { APPLE, DOWNLOAD, GITHUB, LINUX, WINDOWS } from "../lib/icons";

const repo = "https://github.com/mory-dev/sudonotes";
const releasesUrl = "https://github.com/mory-dev/sudonotes/releases";

type Asset = { name: string; url: string; size: number | null };
type Release = {
  tag: string;
  version: string;
  url: string;
  windows: Asset | null;
  linux: Asset | null;
  mac: Asset | null;
};

function formatSize(bytes: number | null): string {
  if (!bytes) return "";
  const mb = bytes / (1024 * 1024);
  return mb >= 10 ? `${Math.round(mb)} MB` : `${mb.toFixed(1)} MB`;
}

// The latest published release, fetched once at build time so the buttons
// always point at the newest signed installer. When there is none yet (or the
// build has no network), the page falls back to building from source.
let release: Release | null = null;
try {
  const res = await fetch(
    "https://api.github.com/repos/mory-dev/sudonotes/releases/latest",
    {
      headers: {
        "User-Agent": "sudonotes-site",
        Accept: "application/vnd.github+json",
      },
    },
  );
  if (res.ok) {
    const data = await res.json();
    const assets: Asset[] = (data.assets ?? []).map((a: any) => ({
      name: String(a.name ?? ""),
      url: String(a.browser_download_url ?? ""),
      size: typeof a.size === "number" ? a.size : null,
    }));
    const byName = (re: RegExp) => assets.find((a) => re.test(a.name.toLowerCase()));
    const windows =
      byName(/setup\.exe$/) ?? byName(/\.exe$/) ?? null;
    const linux =
      byName(/\.appimage$/) ??
      byName(/\.deb$/) ??
      byName(/\.rpm$/) ??
      null;
    const mac = byName(/\.(dmg|app\.tar\.gz)$/) ?? null;
    const tag = String(data.tag_name ?? "");
    release = {
      tag,
      version: tag.replace(/^v/, ""),
      url: String(data.html_url ?? releasesUrl),
      windows,
      linux,
      mac,
    };
  }
} catch {
  release = null;
}

const hasInstaller = !!(release && (release.windows || release.linux));
---

<Base
  title="Download sudonotes"
  description="Download the sudonotes installer for Windows or Linux — built and signed in CI with Azure Trusted Signing. macOS is coming soon."
  schema="software"
>
  <section class="page prose" style="padding-block: clamp(44px, 7vw, 76px)">
    <p class="eyebrow">Download</p>
    <h1>Get sudonotes</h1>

    {hasInstaller ? (
      <>
        <p class="lead">
          <Wordmark /> <strong>v{release!.version}</strong> is ready for Windows and Linux. Every
          release is built from the public source on GitHub.
        </p>

        <div class="download-grid">
          <div class="download-card">
            <span class="download-platform">
              <Icon path={WINDOWS} size={22} label="Windows" />
            </span>
            <h2>Windows</h2>
            {release!.windows ? (
              <>
                <a
                  class="button primary download-button"
                  href={release!.windows.url}
                  rel="noopener"
                  data-download-platform="windows"
                >
                  <Icon path={DOWNLOAD} size={16} stroke />
                  Download installer
                </a>
                <span class="download-meta" data-download-meta="windows">
                  {release!.windows.name} · {formatSize(release!.windows.size)}
                </span>
              </>
            ) : (
              <span class="download-meta">Coming soon</span>
            )}
          </div>

          <div class="download-card">
            <span class="download-platform">
              <Icon path={LINUX} size={22} label="Linux" />
            </span>
            <h2>Linux</h2>
            {release!.linux ? (
              <>
                <a
                  class="button primary download-button"
                  href={release!.linux.url}
                  rel="noopener"
                  data-download-platform="linux"
                >
                  <Icon path={DOWNLOAD} size={16} stroke />
                  Download installer
                </a>
                <span class="download-meta" data-download-meta="linux">
                  {release!.linux.name} · {formatSize(release!.linux.size)}
                </span>
              </>
            ) : (
              <span class="download-meta">Coming soon</span>
            )}
          </div>

        </div>

        <div class="auto-download" id="auto-download" hidden aria-live="polite">
          <span id="auto-download-message"></span>{" "}
          <a id="auto-download-link" href="">Download now</a>
          <span id="cancel-auto-download-separator" aria-hidden="true"> · </span>
          <button id="cancel-auto-download" type="button">Cancel</button>
        </div>

        <p class="coming-soon">
          <Icon path={APPLE} size={15} label="macOS" />
          <span><strong>macOS</strong> is coming soon.</span>
        </p>

        <div class="note">
          <strong>Verify before you install.</strong> The Windows installer is signed with Azure
          Trusted Signing. Every release carries a <code>checksums.txt</code> — compare the SHA-256
          of what you downloaded against it on the{" "}
          <a href={release!.url}>
            release page <span aria-hidden="true">↗</span>
          </a>
          .
        </div>

        <h2>What you get</h2>
        <ul>
          <li class="platform-line">
            <span class="platforms">
              <Icon path={WINDOWS} size={14} label="Windows" />
              <Icon path={LINUX} size={14} label="Linux" />
            </span>
            <span><strong>Windows and Linux.</strong> One codebase, platform-native packages.</span>
          </li>
          <li>
            <strong>No bundled browser.</strong> Tauri uses your system's webview; current download
            sizes are shown above.
          </li>
          <li><strong>No account.</strong> First launch asks you where to keep your vault. That is it.</li>
        </ul>
      </>
    ) : (
      <>
        <div class="note warn">
          <strong>Installers are being prepared.</strong> <Wordmark />'s release pipeline — Windows
          signing with Azure Trusted Signing and Linux packages — is running its first build. Until
          it lands, the honest path is to build from source. It takes two commands and about a
          minute.
        </div>

        <h2>Build it yourself</h2>
        <p>
          You need <a href="https://nodejs.org">Node.js</a>,{" "}
          <a href="https://rustup.rs">Rust</a>, and the{" "}
          <a href="https://tauri.app/start/prerequisites/">Tauri system dependencies</a> for your
          platform.
        </p>

        <pre><code>git clone https://github.com/mory-dev/sudonotes.git</code></pre>
        <pre><code>cd sudonotes/app && npm install && npm run tauri build</code></pre>

        <p>
          The installer lands in <code>app/src-tauri/target/release/bundle/</code>. To run it in
          development instead, use <code>npm run tauri dev</code>.
        </p>
      </>
    )}

    <div class="actions">
      <a class="button primary" href={repo}><Icon path={GITHUB} size={16} />Open the repository</a>
      <a class="button" href="/docs/vault-format">See what it writes to disk</a>
    </div>
  </section>
</Base>

<script>
  const RELEASE_API = "https://api.github.com/repos/mory-dev/sudonotes/releases/latest";
  const RELEASE_ASSET_PATH = "/mory-dev/sudonotes/releases/download/";
  const COUNTDOWN_SECONDS = 5;

  type Platform = "windows" | "linux";
  type ReleaseAsset = { name: string; url: string; size: number | null };

  function currentPlatform(): Platform | null {
    const navigatorWithUserAgentData = navigator as Navigator & {
      userAgentData?: { platform?: string };
    };
    const platform = (
      navigatorWithUserAgentData.userAgentData?.platform ||
      navigator.platform ||
      navigator.userAgent
    ).toLowerCase();
    const userAgent = navigator.userAgent.toLowerCase();

    if (platform.includes("win")) return "windows";
    if (platform.includes("linux") && !userAgent.includes("android") && !userAgent.includes("cros")) {
      return "linux";
    }
    return null;
  }

  function isTrustedAssetUrl(value: string): boolean {
    try {
      const url = new URL(value);
      return url.protocol === "https:" &&
        url.hostname === "github.com" &&
        url.pathname.startsWith(RELEASE_ASSET_PATH);
    } catch {
      return false;
    }
  }

  function formatAssetSize(bytes: number | null): string {
    if (!bytes) return "";
    const mb = bytes / (1024 * 1024);
    return mb >= 10 ? `${Math.round(mb)} MB` : `${mb.toFixed(1)} MB`;
  }

  function findAsset(assets: ReleaseAsset[], platform: Platform): ReleaseAsset | null {
    const byName = (pattern: RegExp) => assets.find((asset) => pattern.test(asset.name.toLowerCase()));
    if (platform === "windows") return byName(/setup\.exe$/) ?? byName(/\.exe$/) ?? null;
    return byName(/\.appimage$/) ?? byName(/\.deb$/) ?? byName(/\.rpm$/) ?? null;
  }

  async function latestAsset(platform: Platform): Promise<ReleaseAsset | null> {
    try {
      const response = await fetch(RELEASE_API, {
        headers: { Accept: "application/vnd.github+json" },
      });
      if (!response.ok) return null;

      const release = await response.json();
      const assets: ReleaseAsset[] = Array.isArray(release.assets)
        ? release.assets.map((asset: { name?: unknown; browser_download_url?: unknown; size?: unknown }) => ({
            name: String(asset.name ?? ""),
            url: String(asset.browser_download_url ?? ""),
            size: typeof asset.size === "number" ? asset.size : null,
          }))
        : [];
      const asset = findAsset(assets, platform);
      return asset && isTrustedAssetUrl(asset.url) ? asset : null;
    } catch {
      return null;
    }
  }

  function pageAsset(platform: Platform): ReleaseAsset | null {
    const link = document.querySelector<HTMLAnchorElement>(`[data-download-platform="${platform}"]`);
    if (!link || !isTrustedAssetUrl(link.href)) return null;
    return { name: "", url: link.href, size: null };
  }

  function updatePlatformLink(platform: Platform, asset: ReleaseAsset): void {
    const link = document.querySelector<HTMLAnchorElement>(`[data-download-platform="${platform}"]`);
    if (link) link.href = asset.url;

    const meta = document.querySelector<HTMLElement>(`[data-download-meta="${platform}"]`);
    if (meta && asset.name) {
      const size = formatAssetSize(asset.size);
      meta.textContent = size ? `${asset.name} · ${size}` : asset.name;
    }
  }

  async function startAutomaticDownload(): Promise<void> {
    const platform = currentPlatform();
    if (!platform) return;

    const asset = (await latestAsset(platform)) ?? pageAsset(platform);
    if (!asset) return;
    updatePlatformLink(platform, asset);

    const container = document.querySelector<HTMLElement>("#auto-download");
    const message = document.querySelector<HTMLElement>("#auto-download-message");
    const downloadLink = document.querySelector<HTMLAnchorElement>("#auto-download-link");
    const cancelButton = document.querySelector<HTMLButtonElement>("#cancel-auto-download");
    const cancelSeparator = document.querySelector<HTMLElement>("#cancel-auto-download-separator");
    if (!container || !message || !downloadLink || !cancelButton || !cancelSeparator) return;

    const platformLabel = platform === "windows" ? "Windows" : "Linux";
    let seconds = COUNTDOWN_SECONDS;
    let cancelled = false;
    downloadLink.href = asset.url;
    container.hidden = false;

    const render = () => {
      message.textContent = `Your ${platformLabel} download starts in ${seconds} second${seconds === 1 ? "" : "s"}.`;
    };
    render();

    const timer = window.setInterval(() => {
      seconds -= 1;
      if (seconds <= 0) {
        window.clearInterval(timer);
        if (!cancelled) {
          message.textContent = `Starting your ${platformLabel} download…`;
          window.location.assign(asset.url);
        }
        return;
      }
      render();
    }, 1000);

    cancelButton.addEventListener("click", () => {
      cancelled = true;
      window.clearInterval(timer);
      message.textContent = "Automatic download cancelled.";
      cancelSeparator.hidden = true;
      cancelButton.hidden = true;
    }, { once: true });
  }

  void startAutomaticDownload();
</script>

<style>
  .lead {
    font-size: 16px;
  }

  .download-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    margin: 26px 0;
  }

  .download-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 20px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .download-card h2 {
    margin: 0 0 4px;
    font-size: 15px;
  }

  .download-platform {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: var(--panel-2);
    color: var(--muted);
    margin-bottom: 4px;
  }

  .download-button {
    box-sizing: border-box;
    justify-content: center;
    width: 100%;
    margin-top: 4px;
    padding-inline: 12px;
    white-space: nowrap;
  }

  .download-meta {
    font-size: 12px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .auto-download {
    margin: -10px 0 26px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel-2);
    font-size: 13px;
  }

  .auto-download a,
  .auto-download button {
    color: var(--accent);
    font: inherit;
    font-weight: 650;
  }

  .auto-download button {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .coming-soon {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: -10px 0 26px;
    color: var(--muted);
    font-size: 13px;
  }

  .platform-line {
    display: flex;
    align-items: baseline;
    gap: 9px;
  }

  .platforms {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transform: translateY(2px);
  }
</style>
